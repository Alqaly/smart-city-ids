        'metadata': {'name': 'low-threat', 'namespace': 'smart-city'},
        'spec': {
            'targetPod': {'name': 'test', 'namespace': 'smart-city'},
            'llmRecommendation': {'severity': 2},  # Low severity
            'actions': []
        }
    }
    
