# =============================================================================
# Smart City IDS - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git!
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys (at least one required)
# -----------------------------------------------------------------------------

# xAI Grok API (Primary - Recommended)
# Get your key at: https://console.x.ai/
XAI_API_KEY=your-xai-api-key-here

# OpenAI API (Fallback)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API (Optional)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini API (Optional)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Moonshot Kimi API (Optional)
KIMI_API_KEY=your-kimi-api-key-here

# -----------------------------------------------------------------------------
# Kubernetes Configuration
# -----------------------------------------------------------------------------

# Kubeconfig path (k3s default)
KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# Primary namespace for workloads
K8S_NAMESPACE=smart-city

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------

POSTGRES_USER=idsuser
POSTGRES_PASSWORD=idspassword
POSTGRES_DB=idsdb

# -----------------------------------------------------------------------------
# IDS API Configuration
# -----------------------------------------------------------------------------

# LLM provider priority (used for failover order)
LLM_PRIORITY=xai,anthropic,openai,gemini,kimi

# Shared LLM behavior
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30

# Severity threshold for automated actions
# 8+ = isolate pod, 6+ = scale up
SEVERITY_THRESHOLD_ISOLATE=8
SEVERITY_THRESHOLD_SCALE=6

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

# Prometheus scrape interval
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana admin password (default: admin)
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Development/Debug
# -----------------------------------------------------------------------------

# Enable debug logging
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
