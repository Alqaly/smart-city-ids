# =====================================================================
# Smart City IDS - Environment Configuration Template
# =====================================================================
# Copy to .env and fill in your real values:
#   cp .env.example .env
#
# After editing .env, sync to Kubernetes with:
#   bash scripts/apply-llm-env-to-k8s-secret.sh
#
# NEVER commit .env to git (.gitignore already excludes it)
# =====================================================================

# ---------------------------------------------------------------------
# LLM API Keys — all 5 cloud providers
# ---------------------------------------------------------------------
# At least one required. kimi is the recommended primary.
# Sync to K8s with:  bash scripts/apply-llm-env-to-k8s-secret.sh

# Moonshot Kimi K2  (Primary)  https://platform.moonshot.cn/
KIMI_API_KEY=

# xAI Grok          (Fallback)  https://console.x.ai/
XAI_API_KEY=

# Anthropic Claude  (Fallback)  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini     (Fallback)  https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI GPT        (Fallback)  https://platform.openai.com/
OPENAI_API_KEY=

# ---------------------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------------------
LLM_PRIORITY=kimi,xai,anthropic,gemini,openai

XAI_MODEL=grok-4-latest
OPENAI_MODEL=gpt-4-turbo-preview
GEMINI_MODEL=gemini-2.0-flash
KIMI_MODEL=moonshot-v1-8k
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# ---------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------
KUBECONFIG=/home/kali/.kube/config
K8S_NAMESPACE=smart-city

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=idspassword
POSTGRES_DB=smartcity_ids
DATABASE_URL=postgresql://postgres:idspassword@postgres:5432/smartcity_ids

# ---------------------------------------------------------------------
# IDS API
# ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
CRITICAL_SEVERITY_THRESHOLD=8
HIGH_SEVERITY_THRESHOLD=6
AUTOMATION_MODE=active
PROTECTED_SERVICES=ids-api,postgres
IDS_INTERNAL_ALERT_TOKEN=change-me

# ---------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------
FALCO_ENABLED=true
SURICATA_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# Rate limiting / Deduplication
# ---------------------------------------------------------------------
DEDUPLICATOR_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=100

# ---------------------------------------------------------------------
# Debug
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
