# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Kubernetes
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
K8S_NAMESPACE=smart-city

# Security Monitor
FALCO_ENDPOINT=http://localhost:2801
PROMETHEUS_URL=http://localhost:9090

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Mock Mode (set to false for production)
MOCK_MODE=true
