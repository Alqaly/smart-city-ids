{
  "dashboard": {
    "uid": "smartcity-ids-working",
    "title": "Smart City IDS - Working Dashboard",
    "tags": ["ids", "smart-city", "working"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "📊 Total Alerts",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "sum(smartcity_ids_alerts_received_total)", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}}},
        "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 2,
        "type": "stat",
        "title": "✅ Processed OK",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "sum(smartcity_ids_alerts_processed_total{result=\"success\"})", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
        "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 3,
        "type": "stat",
        "title": "❌ Errors",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "sum(smartcity_ids_alerts_processed_total{result=\"error\"})", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
        "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 4,
        "type": "stat",
        "title": "🚨 Critical Active",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_critical_alerts_active", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
        "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 5,
        "type": "stat",
        "title": "⏱️ Uptime",
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_uptime_seconds", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}},
        "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 20,
        "type": "stat",
        "title": "🤖 Automation Mode",
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_automation_mode", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "🔴 MANUAL", "color": "red"}, "1": {"text": "🟡 ASSISTED", "color": "yellow"}, "2": {"text": "🟢 AUTO", "color": "green"}}}]}},
        "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 6,
        "type": "row",
        "title": "🤖 LLM Engine Status (5 Engines)",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
        "collapsed": false
      },
      {
        "id": 7,
        "type": "stat",
        "title": "xAI Grok-4",
        "gridPos": {"h": 3, "w": 4, "x": 0, "y": 5},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_circuit_breaker_state{engine=\"xai\"}", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "🟢 HEALTHY", "color": "green"}, "1": {"text": "🟡 TESTING", "color": "yellow"}, "2": {"text": "🔴 FAILING", "color": "red"}}}]}},
        "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 8,
        "type": "stat",
        "title": "OpenAI GPT-4",
        "gridPos": {"h": 3, "w": 4, "x": 4, "y": 5},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_circuit_breaker_state{engine=\"openai\"}", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "🟢 HEALTHY", "color": "green"}, "1": {"text": "🟡 TESTING", "color": "yellow"}, "2": {"text": "🔴 FAILING", "color": "red"}}}]}},
        "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 9,
        "type": "stat",
        "title": "Anthropic Claude",
        "gridPos": {"h": 3, "w": 4, "x": 8, "y": 5},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_circuit_breaker_state{engine=\"anthropic\"}", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "🟢 HEALTHY", "color": "green"}, "1": {"text": "🟡 TESTING", "color": "yellow"}, "2": {"text": "🔴 FAILING", "color": "red"}}}]}},
        "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 10,
        "type": "stat",
        "title": "Google Gemini",
        "gridPos": {"h": 3, "w": 4, "x": 12, "y": 5},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_circuit_breaker_state{engine=\"gemini\"}", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "🟢 HEALTHY", "color": "green"}, "1": {"text": "🟡 TESTING", "color": "yellow"}, "2": {"text": "🔴 FAILING", "color": "red"}}}]}},
        "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 11,
        "type": "stat",
        "title": "Moonshot Kimi",
        "gridPos": {"h": 3, "w": 4, "x": 16, "y": 5},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_circuit_breaker_state{engine=\"kimi\"}", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "🟢 HEALTHY", "color": "green"}, "1": {"text": "🟡 TESTING", "color": "yellow"}, "2": {"text": "🔴 FAILING", "color": "red"}}}]}},
        "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 21,
        "type": "stat",
        "title": "LLM Cache Size",
        "gridPos": {"h": 3, "w": 4, "x": 20, "y": 5},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [{"expr": "smartcity_ids_llm_cache_size", "instant": true, "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short"}},
        "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "📈 Alerts Over Time (by Priority)",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "increase(smartcity_ids_alerts_received_total{priority=\"Critical\"}[5m])", "legendFormat": "🔴 Critical", "refId": "A"},
          {"expr": "increase(smartcity_ids_alerts_received_total{priority=\"Warning\"}[5m])", "legendFormat": "🟡 Warning", "refId": "B"},
          {"expr": "increase(smartcity_ids_alerts_received_total{priority=\"Notice\"}[5m])", "legendFormat": "🔵 Notice", "refId": "C"}
        ],
        "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "auto"}, "color": {"mode": "palette-classic"}}}
      },
      {
        "id": 13,
        "type": "timeseries",
        "title": "🤖 LLM Requests by Engine",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "increase(smartcity_ids_llm_requests_total{engine=\"xai\"}[5m])", "legendFormat": "xAI", "refId": "A"},
          {"expr": "increase(smartcity_ids_llm_requests_total{engine=\"openai\"}[5m])", "legendFormat": "OpenAI", "refId": "B"},
          {"expr": "increase(smartcity_ids_llm_requests_total{engine=\"gemini\"}[5m])", "legendFormat": "Gemini", "refId": "C"},
          {"expr": "increase(smartcity_ids_llm_requests_total{engine=\"anthropic\"}[5m])", "legendFormat": "Anthropic", "refId": "D"},
          {"expr": "increase(smartcity_ids_llm_requests_total{engine=\"kimi\"}[5m])", "legendFormat": "Kimi", "refId": "E"}
        ],
        "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}}
      },
      {
        "id": 14,
        "type": "row",
        "title": "📊 Database & Processing Statistics",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
        "collapsed": false
      },
      {
        "id": 15,
        "type": "piechart",
        "title": "Alerts by Source",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 17},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "sum(smartcity_ids_alerts_received_total) by (source)", "legendFormat": "{{source}}", "refId": "A"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right"}, "pieType": "pie"}
      },
      {
        "id": 16,
        "type": "piechart",
        "title": "Alerts by Priority",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 17},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "sum(smartcity_ids_alerts_received_total) by (priority)", "legendFormat": "{{priority}}", "refId": "A"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right"}, "pieType": "pie"}
      },
      {
        "id": 17,
        "type": "piechart",
        "title": "LLM Results",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 17},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "sum(smartcity_ids_alerts_processed_total) by (result)", "legendFormat": "{{result}}", "refId": "A"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right"}, "pieType": "pie"}
      },
      {
        "id": 18,
        "type": "timeseries",
        "title": "Processing Latency",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 17},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "rate(smartcity_ids_alert_processing_seconds_sum[5m]) / rate(smartcity_ids_alert_processing_seconds_count[5m])", "legendFormat": "Avg Latency", "refId": "A"}
        ],
        "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 20}}}
      },
      {
        "id": 19,
        "type": "table",
        "title": "🔍 Circuit Breaker Details",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 25},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "targets": [
          {"expr": "smartcity_ids_circuit_breaker_state", "format": "table", "instant": true, "refId": "A"}
        ],
        "transformations": [
          {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true}, "renameByName": {"engine": "Engine", "Value": "State (0=OK, 1=Testing, 2=Failing)"}}}
        ]
      }
    ],
    "schemaVersion": 39,
    "version": 1
  },
  "overwrite": true
}
