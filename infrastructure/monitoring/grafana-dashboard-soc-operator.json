      "targets": [
        { "expr": "sum by (priority) (rate(smartcity_ids_alerts_received_total[5m]) * 60)", "legendFormat": "{{priority}}", "refId": "A" }
      ],
      "title": "Alert Rate by Priority (per minute)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
