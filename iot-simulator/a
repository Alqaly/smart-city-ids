    spec:
      containers:
      - name: simulator
        image: python:3.11-slim
        workingDir: /app
        command: ["python", "mqtt_device_enhanced.py"]
        resources:
          limits:
            memory: "128Mi"
            cpu: "200m"
          requests:
            memory: "64Mi"
            cpu: "50m"
        env:
        - name: POD_NAME
