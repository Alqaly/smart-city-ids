          value: "mqtt-broker.smart-city.svc.cluster.local"
        - name: MQTT_PORT
          value: "1883"
        - name: FAILURE_DISCONNECT_PROB
          value: "0.01"
        - name: FAILURE_LATENCY_SPIKE_PROB
          value: "0.02"
