{
  "dashboard": {
    "title": "Smart City IDS - Security Monitoring",
    "panels": [
      {
        "title": "Total Alerts",
        "targets": [
          {
            "expr": "rate(ids_alerts_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "AI Analysis Time",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, ids_ai_analysis_duration_seconds_bucket)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Automated Actions",
        "targets": [
          {
            "expr": "ids_automated_actions_total"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Alert Severity Distribution",
        "targets": [
          {
            "expr": "ids_alerts_total"
          }
        ],
        "type": "piechart"
      }
    ]
  }
}
