// IoT Live Stream WebSocket
var iotWS=null;
var iotStreamCount=0;
var iotStreamOpen=true;

function getIoTStreamUrls(){
  var host=window.location.hostname||'localhost';
  return [
    'ws://'+host+':30810',          // NodePort
    'ws://localhost:30810',         // local nodeport
    'ws://localhost:8081',          // optional port-forward
    'ws://127.0.0.1:8081'
  ];
}

function connectIoTStream(){
  if(iotWS){try{iotWS.close()}catch(e){}}
  var dot=document.getElementById('iotStreamDot');
  var status=document.getElementById('iotStreamStatus');
  var log=document.getElementById('iotStreamLog');
  dot.className='dot dot-yellow';
  status.textContent='Connecting to MQTT bridge...';

  var urls=getIoTStreamUrls();
  var idx=0;

  function tryNext(){
    if(idx>=urls.length){
      dot.className='dot dot-red';
      status.textContent='Bridge unavailable (check iot-stream-bridge service)';
      return;
    }
    var ws=new WebSocket(urls[idx]);
    idx+=1;
    ws.onopen=function(){
      iotWS=ws;
      dot.className='dot dot-green';
      status.textContent='Live IoT MQTT traffic';
      log.innerHTML='<span style="color:var(--green)">\\u2713 Connected to IoT stream bridge.</span>';
    };
    ws.onmessage=function(event){
      try{
        var data=JSON.parse(event.data);
        if(data.type!=='iot_message')return;
        iotStreamCount+=1;
        document.getElementById('iotStreamCount').textContent=iotStreamCount;
        var msg=data.data||{};
        var ts=new Date().toLocaleTimeString();
        var device=msg.device||msg.device_id||'unknown';
        var ns=msg.namespace||'smart-city';
        var sample=msg.vehicle_count||msg.temperature_c||msg.power_kw||msg.value||'data';
        var rate=Math.round((data.total_rate||0)*60);
        var line='['+ts+'] '+device+' ('+ns+') -> '+sample+' | '+rate+'/min\\n';
        log.textContent=line+log.textContent.slice(0,8000);
      }catch(e){
        console.warn('IoT WS parse error',e);
      }
    };
    ws.onerror=function(){try{ws.close()}catch(e){}};
    ws.onclose=function(){
      if(iotWS===ws){iotWS=null;}
      if(dot.className.indexOf('dot-green')!==-1){
        dot.className='dot dot-red';
        status.textContent='Disconnected ‚Äî reconnecting...';
        setTimeout(connectIoTStream,2000);
      }else{
        tryNext();
      }
    };
  }

  tryNext();
}

