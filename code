          } else if (sev >= 4) {
            line += `‚îÇ  <span style="color:var(--text2)">üìã QUEUED:</span> ${act} <span style="color:var(--text3)">[MEDIUM ‚Äî requires approval]</span>\n`;
          } else {
            line += `‚îÇ  <span style="color:var(--text3)">‚ÑπÔ∏è LOGGED:</span> ${act} <span style="color:var(--text3)">[LOW ‚Äî informational only]</span>\n`;
          }
        });
        if (sev >= 6 && container) {
          line += `‚îÇ  Target: ${container}\n`;
        }
      }
      line += '‚îî‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';

      // Prepend (newest on top)
      let old = log.innerHTML;
      if (old === 'Connecting to live event stream...') old = '';
      log.innerHTML = line + '\n' + old;

      // Audio alert for critical severity
      if (typeof window._handleAudioAlert === 'function') {
