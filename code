                        SELECT * FROM throttled_alerts WHERE rule = %s
                        ORDER BY created_at DESC LIMIT %s
                    """, (rule, limit))
                else:
                    cur.execute("""
                        SELECT * FROM throttled_alerts
                        ORDER BY created_at DESC LIMIT %s
                    """, (limit,))
