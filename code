// Pending queue renderer: analyst approve/reject workflow for critical actions.
function loadPending(){
  apiFetch('/api/governance/pending').then(function(data){
    var el=document.getElementById('pendingActions');
    if(!data||!data.pending||!data.pending.length){el.innerHTML='<div style="padding:20px;color:var(--text3);text-align:center">No actions pending approval</div>';return}
    var html='<table><thead><tr><th>Action</th><th>Target</th><th>Severity</th><th>Reason</th><th>Actions</th></tr></thead><tbody>';
    data.pending.forEach(function(a){
      html+='<tr><td>'+(a.action_type||a.action||'-')+'</td><td>'+(a.target||'-')+'</td><td><span class="badge '+sevBadge(a.severity)+'">'+(a.severity||'-')+'</span></td><td style="max-width:200px">'+esc(((a.rationale||a.reason||'')).substring(0,100))+'</td><td><button class="btn btn-success btn-sm" onclick="approveAction(\''+a.id+'\')">Approve</button> <button class="btn btn-danger btn-sm" onclick="rejectAction(\''+a.id+'\')">Reject</button></td></tr>';
    });
    el.innerHTML=html+'</tbody></table>';
  });
}
function approveAction(id){apiFetch('/api/governance/approve/'+id,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({analyst_comment:'Approved via dashboard'})}).then(function(){addLog('Action '+id+' approved');refreshAll()})}
