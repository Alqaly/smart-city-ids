            for alert in alerts[:5]:
                response += f"‚Ä¢ [{alert.get('severity', '?')}] {alert.get('rule', 'Unknown')}\n"
                response += f"  {alert.get('summary', '')[:100]}...\n\n"
        else:
            response = "No recent alerts found."
        
        return {
            "response": response,
            "tool_calls": [{"name": "get_active_alerts", "arguments": {"limit": 10}}],
            "tool_results": [result],
            "context": context
        }
    
    # Check for system health queries
    if any(kw in message_lower for kw in ["health", "status", "system"]):
        result = await execute_tool_call("get_system_health", {}, governance_mode)
        context["health"] = result
        
        if result.get("status") == "success":
            response = "System health status:\n"
            for component, status in result.items():
                if isinstance(status, dict):
                    response += f"‚Ä¢ {component}: {status.get('status', 'unknown')}\n"
        else:
            response = "System health check completed."
        
        return {
            "response": response,
            "tool_calls": [{"name": "get_system_health", "arguments": {}}],
            "tool_results": [result],
            "context": context
        }
    
    # Default response
    return {
        "response": (
            "I can help you with:\n"
            "‚Ä¢ Checking alert status\n"
            "‚Ä¢ Viewing system health\n"
