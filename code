def _build_summary(credits: Dict[str, Any]) -> Dict[str, Any]:
    """Build summary statistics from credit data"""
    total = len(credits)
    ok = sum(1 for c in credits.values() if c.status == "ok")
    warning = sum(1 for c in credits.values() if c.status == "warning")
    critical = sum(1 for c in credits.values() if c.status in ["critical", "exhausted"])
    errors = sum(1 for c in credits.values() if c.status == "error")
    
    # Calculate total available credits
    total_credits = sum(
        c.credits for c in credits.values() 
        if c.credits is not None and c.status not in ["error", "unknown"]
    )
    
    return {
        "total_providers": total,
        "healthy": ok,
        "warning": warning,
        "critical": critical,
        "errors": errors,
        "total_available_usd": round(total_credits, 2)
    }


def _get_display_name(provider: str) -> str:
    """Get human-readable provider name"""
    names = {
