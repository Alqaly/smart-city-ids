      if (mitre)      line += `‚îÇ  MITRE:       <span style="color:#ef4444">${mitre}</span>\n`;
      if (procTime)    line += `‚îÇ  Processed:   ${procTime}\n`;
      if (summary)     line += `‚îÇ  Summary:     ${summary}\n`;
      if (reasoning) {
        line += '‚îú‚îÄ‚îÄ üß† Reasoning Chain ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
