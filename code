def _classify_llm_error(error_msg: str) -> str:
    """Classify an LLM error into a human-readable diagnostic reason."""
    if not error_msg:
        return "Unknown error"
    msg = error_msg.lower()
    if "invalid api key" in msg or "incorrect api key" in msg or "api error 401" in msg:
        return "Invalid API key ‚Äî check your key is correct and not expired"
    if "unauthorized" in msg or "authentication" in msg or "api error 403" in msg:
        return "Authentication failed ‚Äî API key rejected by provider"
    if "insufficient_quota" in msg or "quota" in msg or "api error 429" in msg:
        return "Insufficient credits / quota exceeded ‚Äî add billing or wait for reset"
    if "resource has been exhausted" in msg or "used all available credits" in msg:
        return "Credits exhausted ‚Äî provider account has no remaining balance"
    if "monthly spending limit" in msg:
        return "Monthly spending limit reached ‚Äî increase limit in provider settings"
    if "exhausted" in msg:
        return "Resource exhausted ‚Äî provider capacity limit reached"
    if "timeout" in msg:
        return "Request timeout ‚Äî provider too slow or network issue"
    if "connection" in msg or "connect" in msg:
        return "Connection failed ‚Äî network error or provider is down"
    if "rate limit" in msg or "rate_limit" in msg:
        return "Rate limited ‚Äî too many requests, will retry after cooldown"
    if "model not found" in msg or "model_not_found" in msg:
        return "Model not found ‚Äî configured model is unavailable on this provider"
    if "api error" in msg:
        return f"API error ‚Äî {error_msg}"
    if "cooldown" in msg:
        return error_msg  # Already descriptive
    return f"Error: {error_msg}"


