        "Reconnaissance",
        "Lateral Movement",
        "Initial Access",
        "Command and Control",
        "Unauthorized Access",
        "Configuration Error",
        "Unclassified",
        "Unknown"
    ] = Field(
        default="Unknown",
        description="Categorized threat type"
    )
    
    confidence: float = Field(
        default=0.5,
        ge=0.0,
        le=1.0,
        description="Analysis confidence (0.0-1.0)"
    )
    
    key_indicators: List[str] = Field(
        default_factory=list,
        max_length=10,
