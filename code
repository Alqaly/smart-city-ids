body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
#loginScreen{display:flex;align-items:center;justify-content:center;min-height:100vh;background:linear-gradient(135deg,#0f1923 0%,#1a1040 50%,#0f1923 100%)}
.login-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:48px;width:400px;box-shadow:var(--shadow)}
.login-card h1{font-size:22px;margin-bottom:6px;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.login-card p{color:var(--text2);font-size:13px;margin-bottom:28px}
.login-card label{display:block;color:var(--text2);font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.login-card input{width:100%;padding:10px 14px;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);font-size:14px;margin-bottom:16px;outline:none;transition:border .2s}
.login-card input:focus{border-color:var(--accent)}
.login-card button{width:100%;padding:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;border-radius:var(--radius);font-size:14px;font-weight:600;cursor:pointer;transition:opacity .2s}
.login-card button:hover{opacity:.9}
#loginError{color:var(--red);font-size:13px;margin-top:8px;display:none}
#dashboard{display:none}
.topbar{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:56px;background:var(--surface);border-bottom:1px solid var(--border);backdrop-filter:blur(12px)}
.topbar .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}
.topbar-right{display:flex;align-items:center;gap:16px}
.topbar-right .pill{font-size:11px;padding:4px 10px;border-radius:99px;font-weight:600;text-transform:uppercase;letter-spacing:.4px}
.pill-ok{background:rgba(34,197,94,.15);color:var(--green)}
.pill-warn{background:rgba(234,179,8,.15);color:var(--yellow)}
.pill-err{background:rgba(239,68,68,.15);color:var(--red)}
.pill-success{background:rgba(34,197,94,.18);color:var(--green)}
.topbar-right button{background:transparent;border:1px solid var(--border);color:var(--text2);padding:6px 14px;border-radius:var(--radius);font-size:12px;cursor:pointer;transition:all .2s}
.topbar-right button:hover{border-color:var(--accent);color:var(--text)}
.tab-bar{display:flex;gap:0;background:var(--surface);border-bottom:1px solid var(--border);padding:0 24px;overflow-x:auto}
.tab-btn{padding:12px 20px;font-size:13px;font-weight:600;color:var(--text3);background:none;border:none;cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap}
.tab-btn:hover{color:var(--text2)}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}
.tab-panel{display:none;padding:24px;animation:fadeIn .2s}
.tab-panel.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@keyframes attackFlow{
0%{left:0;opacity:.7;transform:scale(1)}
25%{left:25%;opacity:1;transform:scale(1.25)}
50%{left:50%;opacity:.8;transform:scale(1.1)}
75%{left:75%;opacity:.65;transform:scale(1.2)}
100%{left:100%;opacity:0;transform:scale(.8)}
}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.stat-card.blue::before{background:var(--accent)}
.stat-card.purple::before{background:var(--accent2)}
.stat-card.green::before{background:var(--green)}
.stat-card.red::before{background:var(--red)}
.stat-card.yellow::before{background:var(--yellow)}
.stat-card.orange::before{background:var(--orange)}
.stat-label{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-bottom:8px}
.stat-value{font-size:28px;font-weight:700}
.stat-sub{font-size:12px;color:var(--text2);margin-top:4px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:16px;overflow:hidden}
.card-header{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border)}
.card-header h3{font-size:14px;font-weight:700}
.card-body{padding:16px 20px}
.card-body.no-pad{padding:0}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:10px 16px;color:var(--text3);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.4px;border-bottom:1px solid var(--border);background:var(--bg)}
td{padding:10px 16px;border-bottom:1px solid rgba(45,74,94,.3)}
tr:hover td{background:rgba(0,212,255,.03)}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
.dot-green{background:var(--green)}.dot-red{background:var(--red)}.dot-yellow{background:var(--yellow)}.dot-blue{background:var(--accent)}
.badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600}
.badge-crit{background:rgba(239,68,68,.15);color:var(--red)}
.badge-high{background:rgba(249,115,22,.15);color:var(--orange)}
.badge-med{background:rgba(234,179,8,.15);color:var(--yellow)}
.badge-low{background:rgba(34,197,94,.15);color:var(--green)}
.badge-info{background:rgba(0,212,255,.12);color:var(--accent)}
.badge-purple{background:rgba(124,92,252,.15);color:var(--accent2)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.pipeline-grid{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:10px;margin-bottom:16px}
.pipeline-stage{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px}
.pipeline-stage .name{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:.4px}
.pipeline-stage .rate{font-size:20px;font-weight:700;margin-top:4px}
.pipeline-stage .meta{font-size:11px;color:var(--text2);margin-top:2px}
@media(max-width:1200px){.pipeline-grid{grid-template-columns:1fr 1fr}#iotServiceCards{grid-template-columns:1fr!important}}
@media(max-width:900px){.row{grid-template-columns:1fr}}
.btn{padding:8px 16px;border-radius:var(--radius);border:none;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s}
.btn-primary{background:var(--accent);color:#000}.btn-primary:hover{opacity:.85}
.btn-danger{background:var(--red);color:#fff}.btn-danger:hover{opacity:.85}
.btn-outline{background:none;border:1px solid var(--border);color:var(--text2)}.btn-outline:hover{border-color:var(--accent);color:var(--text)}
.btn-success{background:var(--green);color:#fff}.btn-success:hover{opacity:.85}
.btn-sm{padding:4px 10px;font-size:11px}
.provider-card{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--bg);border-radius:var(--radius);border:1px solid var(--border)}
.provider-icon{width:36px;height:36px;border-radius:8px;background:var(--surface2);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--accent)}
.provider-info{flex:1}
.provider-name{font-size:13px;font-weight:600}
.provider-detail{font-size:11px;color:var(--text3)}
.feed{max-height:350px;overflow-y:auto}
.feed-item{display:flex;gap:12px;padding:10px 16px;border-bottom:1px solid rgba(45,74,94,.3);font-size:12px;transition:background .1s}
.feed-item:hover{background:rgba(0,212,255,.03)}
.feed-time{color:var(--text3);min-width:70px;white-space:nowrap}
.feed-source{min-width:60px}
.feed-msg{flex:1;color:var(--text2)}
.progress{height:6px;background:var(--bg);border-radius:3px;overflow:hidden;margin-top:6px}
.progress-fill{height:100%;border-radius:3px;transition:width .5s}
.attack-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.attack-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:16px;cursor:pointer;transition:all .2s}
.attack-card:hover{border-color:var(--accent);transform:translateY(-1px)}
.attack-card h4{font-size:13px;margin-bottom:4px}
.attack-card p{font-size:11px;color:var(--text3)}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;z-index:200}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:32px;width:500px;max-width:90vw;max-height:80vh;overflow-y:auto}
.modal h2{font-size:18px;margin-bottom:16px}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
</style>
</head>
<body>

<div id="loginScreen">
<div class="login-card">
  <h1>Smart City IDS</h1>
  <p>Security Analyst Dashboard &mdash; Intrusion Detection System</p>
  <label>Username</label>
  <input id="loginUser" value="analyst" autocomplete="username">
  <label>Password</label>
  <input id="loginPass" type="password" value="analyst" autocomplete="current-password">
  <button onclick="doLogin()">Sign In</button>
  <div id="loginError"></div>
</div>
</div>

<div id="dashboard">

<div class="topbar">
  <div class="brand">&#x1F6E1;&#xFE0F; Smart City IDS</div>
  <div class="topbar-right">
    <span id="clusterPill" class="pill pill-ok">K8s Connected</span>
    <span id="llmPill" class="pill pill-ok">LLM Ready</span>
    <span id="govPill" class="pill pill-ok">Assisted Mode</span>
    <span style="color:var(--text3);font-size:12px" id="uptimeLabel">Uptime: --</span>
    <button onclick="doLogout()">Sign Out</button>
  </div>
</div>
<div style="padding:8px 24px;border-bottom:1px solid var(--border);background:rgba(0,212,255,.03);font-size:12px;color:var(--text2)">This dashboard helps security analysts triage and explain alerts, not replace them.</div>

<div class="tab-bar">
  <button class="tab-btn active" data-tab="overview">Overview</button>
  <button class="tab-btn" data-tab="alerts">Live Alerts</button>
  <button class="tab-btn" data-tab="kubernetes">Kubernetes</button>
  <button class="tab-btn" data-tab="iot">IoT Devices</button>
  <button class="tab-btn" data-tab="llm">LLM Providers</button>
  <button class="tab-btn" data-tab="governance">Governance / HITL</button>
  <button class="tab-btn" data-tab="attacks">Attack Simulation</button>
</div>

<div class="tab-panel active" id="tab-overview">
  <div class="stat-grid" id="overviewStats"></div>
  <div class="pipeline-grid" id="pipelineOverview"></div>
  <div class="card"><div class="card-header"><h3>Alert Fatigue (Last Window)</h3></div><div class="card-body" id="alertFatigue"></div></div>
  <div class="row">
    <div class="card">
      <div class="card-header"><h3>Live Alert Feed</h3><span class="badge badge-info" id="alertCountBadge">0</span></div>
      <div class="card-body no-pad"><div class="feed" id="alertFeed"><div style="padding:20px;color:var(--text3);text-align:center">Waiting for alerts...</div></div></div>
    </div>
    <div>
      <div class="card">
        <div class="card-header"><h3>LLM Provider Status</h3></div>
        <div class="card-body" id="llmOverview"></div>
      </div>
      <div class="card">
        <div class="card-header"><h3>System Health</h3></div>
        <div class="card-body" id="systemHealth"></div>
      </div>
    </div>
  </div>
</div>

<div class="tab-panel" id="tab-alerts">
  <div class="card">
    <div class="card-header">
      <h3>Alert History</h3>
      <div style="display:flex;gap:8px">
        <select id="alertSourceFilter" style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:4px 8px;border-radius:4px;font-size:12px">
          <option value="">All Sources</option><option value="falco">Falco</option><option value="suricata">Suricata</option>
        </select>
        <button class="btn btn-outline btn-sm" onclick="loadAlerts()">Refresh</button>
      </div>
    </div>
    <div class="card-body no-pad"><table><thead><tr><th>Time</th><th>Trace</th><th>Source</th><th>Rule</th><th>Severity</th><th>Threat</th><th style="min-width:320px">Summary</th><th>Actions</th></tr></thead><tbody id="alertsTable"></tbody></table></div>
  </div>
</div>

<div class="tab-panel" id="tab-kubernetes">
  <div class="stat-grid" id="k8sStats"></div>
  <div style="padding:8px 12px;margin-bottom:8px;font-size:12px;color:var(--text3);background:rgba(0,212,255,.04);border-radius:6px;border:1px solid var(--border)" id="k8sExplain"></div>
  <div class="row">
    <div class="card">
      <div class="card-header"><h3>Pods</h3><span style="font-size:11px;color:var(--text3);margin-left:8px">Running container instances</span><button class="btn btn-outline btn-sm" onclick="loadK8s()">Refresh</button></div>
      <div class="card-body no-pad"><table><thead><tr><th>Pod</th><th>Status</th><th>Restarts</th><th>Namespace</th></tr></thead><tbody id="podsTable"></tbody></table></div>
    </div>
    <div class="card">
      <div class="card-header"><h3>Services</h3><span style="font-size:11px;color:var(--text3);margin-left:8px">Stable network endpoints that route to pods</span></div>
      <div class="card-body no-pad"><table><thead><tr><th>Service</th><th>Type</th><th>Port(s)</th><th>Namespace</th></tr></thead><tbody id="servicesTable"></tbody></table></div>
    </div>
  </div>
</div>

<div class="tab-panel" id="tab-iot">
  <div class="stat-grid" id="iotStats"></div>

  <!-- Protocol Emulator Service Cards -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-bottom:24px" id="iotServiceCards">
    <!-- Traffic Camera ONVIF -->
    <div class="card" id="svc-traffic-camera">
      <div class="card-header" style="border-left:3px solid var(--accent)">
        <h3 style="display:flex;align-items:center;gap:8px"><span style="font-size:16px">&#x1F4F7;</span> Traffic Camera</h3>
        <span class="badge badge-info" id="tc-status">Loading...</span>
      </div>
      <div class="card-body" style="font-size:12px">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span style="color:var(--text3)">Protocol</span><strong>ONVIF Profile S</strong></div>
        <div id="tc-detail" style="color:var(--text3);text-align:center;padding:12px">Loading telemetry...</div>
      </div>
    </div>
    <!-- Parking System MQTT/CoAP -->
    <div class="card" id="svc-parking-system">
      <div class="card-header" style="border-left:3px solid var(--green)">
        <h3 style="display:flex;align-items:center;gap:8px"><span style="font-size:16px">&#x1F17F;&#xFE0F;</span> Parking System</h3>
        <span class="badge badge-info" id="pk-status">Loading...</span>
      </div>
      <div class="card-body" style="font-size:12px">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span style="color:var(--text3)">Protocol</span><strong>MQTT / CoAP / SenML</strong></div>
        <div id="pk-detail" style="color:var(--text3);text-align:center;padding:12px">Loading telemetry...</div>
      </div>
    </div>
    <!-- Healthcare FHIR R4 -->
    <div class="card" id="svc-healthcare-api">
      <div class="card-header" style="border-left:3px solid var(--red)">
        <h3 style="display:flex;align-items:center;gap:8px"><span style="font-size:16px">&#x1F3E5;</span> Healthcare API</h3>
        <span class="badge badge-info" id="hc-status">Loading...</span>
      </div>
      <div class="card-body" style="font-size:12px">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span style="color:var(--text3)">Protocol</span><strong>HL7 FHIR R4</strong></div>
        <div id="hc-detail" style="color:var(--text3);text-align:center;padding:12px">Loading telemetry...</div>
      </div>
    </div>
    <!-- Environmental Sensor Modbus/OPC UA -->
    <div class="card" id="svc-env-sensor">
      <div class="card-header" style="border-left:3px solid var(--yellow)">
        <h3 style="display:flex;align-items:center;gap:8px"><span style="font-size:16px">&#x1F32C;&#xFE0F;</span> Env Sensor</h3>
        <span class="badge badge-info" id="ev-status">Loading...</span>
      </div>
      <div class="card-body" style="font-size:12px">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span style="color:var(--text3)">Protocol</span><strong>Modbus TCP + OPC UA</strong></div>
        <div id="ev-detail" style="color:var(--text3);text-align:center;padding:12px">Loading telemetry...</div>
      </div>
    </div>
    <!-- Street Lighting DALI-2 / TALQ -->
    <div class="card" id="svc-street-lighting">
      <div class="card-header" style="border-left:3px solid var(--orange)">
        <h3 style="display:flex;align-items:center;gap:8px"><span style="font-size:16px">&#x1F4A1;</span> Street Lighting</h3>
        <span class="badge badge-info" id="sl-status">Loading...</span>
      </div>
      <div class="card-body" style="font-size:12px">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span style="color:var(--text3)">Protocol</span><strong>DALI-2 + TALQ v2.4</strong></div>
        <div id="sl-detail" style="color:var(--text3);text-align:center;padding:12px">Loading telemetry...</div>
      </div>
    </div>
  </div>

  <!-- Live Telemetry Data tables -->
  <div class="row" style="margin-bottom:16px">
    <div class="card">
      <div class="card-header"><h3>&#x1F4F9; ANPR &amp; Camera Telemetry</h3><span style="font-size:11px;color:var(--text3)">ONVIF real-time feed</span></div>
      <div class="card-body" id="tc-telemetry" style="font-size:12px;color:var(--text3)">Waiting for data...</div>
    </div>
    <div class="card">
      <div class="card-header"><h3>&#x1F3E5; Medical Device Telemetry</h3><span style="font-size:11px;color:var(--text3)">IEEE 11073 devices</span></div>
      <div class="card-body" id="hc-telemetry" style="font-size:12px;color:var(--text3)">Waiting for data...</div>
    </div>
  </div>

  <div class="row" style="margin-bottom:16px">
    <div class="card">
      <div class="card-header"><h3>&#x1F32C;&#xFE0F; Air Quality Index (AQI)</h3><span style="font-size:11px;color:var(--text3)">EPA standard, 5 monitoring stations</span></div>
      <div class="card-body" id="ev-aqi" style="font-size:12px;color:var(--text3)">Waiting for data...</div>
    </div>
    <div class="card">
      <div class="card-header"><h3>&#x1F4A1; Lighting Zones</h3><span style="font-size:11px;color:var(--text3)">DALI-2 dimming by zone</span></div>
      <div class="card-body" id="sl-zones" style="font-size:12px;color:var(--text3)">Waiting for data...</div>
    </div>
  </div>

  <div class="card" style="margin-bottom:16px">
    <div class="card-header"><h3>&#x1F17F;&#xFE0F; Parking Lot Occupancy</h3><span style="font-size:11px;color:var(--text3)">Magnetometer + Ultrasonic Sensor Fusion</span></div>
    <div class="card-body" id="pk-lots" style="font-size:12px;color:var(--text3)">Waiting for data...</div>
  </div>

  <!-- Fleet device table -->
  <div class="card">
    <div class="card-header"><h3>IoT Device Fleet</h3><span style="font-size:11px;color:var(--text3);margin-left:8px">All K8s IoT pods</span><button class="btn btn-outline btn-sm" onclick="loadIoT()">Refresh</button></div>
    <div class="card-body no-pad"><table><thead><tr><th>Device / Pod</th><th>Type</th><th>Status</th><th>Namespace</th><th>IP</th></tr></thead><tbody id="iotTable"></tbody></table></div>
  </div>
</div>

<div class="tab-panel" id="tab-llm">
  <div class="stat-grid" id="llmStats"></div>
  <div class="row">
    <div class="card">
      <div class="card-header"><h3>Latency by Engine</h3><span style="font-size:11px;color:var(--text3)">p50 / p95 / avg (seconds)</span></div>
      <div class="card-body" id="llmLatencyChart"></div>
    </div>
    </div>
  <div class="card">
    <div class="card-header"><h3>Tokens per Request</h3></div>
    <div class="card-body no-pad"><table><thead><tr><th>Engine</th><th>Prompt Tokens</th><th>Completion Tokens</th><th>Total Tokens</th><th>Avg Tokens/Req</th></tr></thead><tbody id="llmTokenTable"></tbody></table></div>
  </div>
  <div class="row">
    <div class="card">
      <div class="card-header"><h3>Provider Details</h3></div>
      <div class="card-body" id="llmProviderCards"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3>Circuit Breaker Status</h3><button class="btn btn-outline btn-sm" onclick="resetCircuitBreakers()">Reset All</button></div>
      <div class="card-body" id="circuitBreakerDetail"></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3>Deduplication Statistics</h3></div>
    <div class="card-body" id="dedupDetail"></div>
  </div>
</div>

<div class="tab-panel" id="tab-governance">
  <div class="stat-grid" id="govStats"></div>
  <div class="row">
    <div class="card">
      <div class="card-header"><h3>Automation Mode</h3></div>
