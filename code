      (ds==='cooldown'||ds==='recovering')?'dot-yellow':
      (ds==='error'||ds==='circuit_open')?'dot-red':
      !isConfigured?'dot-yellow':'dot-green';
    var stats=info?' | '+(info.successes||0)+' ok / '+(info.failures||0)+' fail':'';
