/* ‚îÄ‚îÄ CSS Custom Properties (Theme Tokens) ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ */
:root {
  --bg: #0f1923;
  --surface: #1a2736;
  --surface2: #243447;
  --border: #2d4a5e;
  --accent: #00d4ff;
  --accent2: #7c5cfc;
  --green: #22c55e;
  --yellow: #eab308;
  --red: #ef4444;
  --orange: #f97316;
  --text: #e2e8f0;
  --text2: #94a3b8;
  --text3: #64748b;
  --radius: 8px;
  --shadow: 0 4px 24px rgba(0, 0, 0, .3);
  --glass: rgba(26, 39, 54, .8);
  --glow: 0 0 20px rgba(0, 212, 255, .08);
  color-scheme: dark;
}

/* Light theme ‚Äî activated by adding class="light" to <html> */
html.light {
  --bg: #f0f4f8;
