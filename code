def _get_status_color(status: str) -> str:
    """Get color code for status"""
    colors = {
        "ok": "#28a745",      # Green
        "warning": "#ffc107",  # Yellow
        "critical": "#dc3545", # Red
        "exhausted": "#6c757d", # Gray
        "error": "#6f42c1",    # Purple
        "unknown": "#6c757d"   # Gray
    }
    return colors.get(status, "#6c757d")


def _generate_credit_alerts(credits: Dict[str, Any]) -> list:
    """Generate alerts for low credits"""
    alerts = []
    
    for name, info in credits.items():
        if info.status == "exhausted":
            alerts.append({
                "level": "error",
                "provider": name,
                "message": f"{name} credits exhausted - will use fallback"
            })
        elif info.status == "critical":
            alerts.append({
                "level": "warning",
                "provider": name,
                "message": f"{name} credits critically low (${info.credits:.2f})"
            })
        elif info.status == "error":
            alerts.append({
                "level": "warning",
                "provider": name,
                "message": f"{name} credit check failed: {info.error_message}"
            })
    
    return alerts


