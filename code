/* ‚îÄ‚îÄ‚îÄ SSE Live Pipeline Feed ‚îÄ‚îÄ‚îÄ */
var _sse=null;
var _sseFeedCount=0;
var _sseFeedOpen=true;

function connectLiveFeed(){
  if(_sse){try{_sse.close()}catch(e){}}
  var dot=document.getElementById('liveFeedDot');
  var status=document.getElementById('liveFeedStatus');
  dot.className='dot dot-yellow'; status.textContent='Connecting...';

  _sse=new EventSource(API+'/api/alerts/live');

  _sse.onopen=function(){
    dot.className='dot dot-green'; status.textContent='Connected ‚Äî streaming all alert processing';
  };

  _sse.addEventListener('connected',function(ev){
    // Clear the 'Connecting...' placeholder when SSE confirms connection
    var log=document.getElementById('liveFeedLog');
    if(log.innerHTML==='Connecting to live event stream...'){
      log.innerHTML='<span style="color:var(--green)">\u2713 Connected to live pipeline stream. Alerts from ALL sources (CLI, Falco, Suricata, dashboard) will appear here in real-time.</span>';
    }
  });

  _sse.addEventListener('alert',function(ev){
    try{
      var d=JSON.parse(ev.data);
      _sseFeedCount++;
      document.getElementById('liveFeedCount').textContent=_sseFeedCount;

      var log=document.getElementById('liveFeedLog');
      var ts=new Date().toLocaleTimeString();
      var sev=d.severity||'?';
      var sevColor=sev>=8?'#ef4444':sev>=5?'#f59e0b':'#22c55e';
      var engine=d.llm_engine||d.engine||'unknown';
      var threat=d.threat_type||'Unknown';
      var summary=d.summary||'';
      var source=d.source||'api';
      var traceId=d.trace_id||('alert-'+(d.alert_id||'unknown'));
      var rule=d.rule||'';
      var container=d.container_name||'';
      var procTime=d.processing_time_ms?d.processing_time_ms+'ms':'';

      // Extract analysis details if present
      var a=d.analysis||{};
      var reasoning=a.reasoning||a.detailed_analysis||'';
      var confidence=a.confidence_score||a.confidence||'';
      var impact=a.business_impact||a.potential_impact||'';
      var indicators=(a.key_indicators||a.indicators||a.ioc||[]);
      var mitigating=(a.mitigating_factors||[]);
      var recs=(a.recommendations||[]);
      var actions=(a.automated_actions||d.automated_actions||[]);
      var mitre=a.mitre_technique||'';

      var line='';
      line+='‚îå‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
      line+='‚îÇ  ['+ts+']  LIVE ALERT ‚Äî Source: '+source.toUpperCase()+'\n';
      line+='‚îÇ  Trace: '+traceId+'\n';
      if(rule) line+='‚îÇ  Rule: '+rule+'\n';
      if(container) line+='‚îÇ  Container: '+container+'\n';
      line+='‚îú‚îÄ‚îÄ LLM Analysis ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
      line+='‚îÇ  Engine:      '+engine+'\n';
      line+='‚îÇ  Severity:    <span style="color:'+sevColor+';font-weight:bold">'+sev+'/10</span>\n';
      line+='‚îÇ  Threat Type: '+threat+'\n';
      if(mitre) line+='‚îÇ  MITRE:       '+mitre+'\n';
      if(confidence) line+='‚îÇ  Confidence:  '+confidence+'\n';
      if(procTime) line+='‚îÇ  Processed:   '+procTime+'\n';
      if(summary) line+='‚îÇ  Summary:     '+summary+'\n';
      if(reasoning){
        line+='‚îú‚îÄ‚îÄ Reasoning ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
        line+='‚îÇ  '+reasoning.replace(/\n/g,'\n‚îÇ  ')+'\n';
      }
      if(impact){
        line+='‚îú‚îÄ‚îÄ Business Impact ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
        line+='‚îÇ  '+impact.replace(/\n/g,'\n‚îÇ  ')+'\n';
      }
      if(indicators.length){
        line+='‚îú‚îÄ‚îÄ Key Indicators ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
        indicators.forEach(function(ind){line+='‚îÇ  ‚Ä¢ '+ind+'\n'});
      }
      if(mitigating.length){
        line+='‚îú‚îÄ‚îÄ Mitigating Factors ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
        mitigating.forEach(function(m){line+='‚îÇ  ‚ó¶ '+m+'\n'});
      }
      if(recs.length){
        line+='‚îú‚îÄ‚îÄ Recommendations ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
        recs.forEach(function(r){line+='‚îÇ  ‚Üí '+r+'\n'});
      }
      if(actions.length){
        var actSev=sev>=8?'<span style="color:#ef4444;font-weight:bold">EXECUTING</span>':sev>=6?'<span style="color:#f59e0b;font-weight:bold">EXECUTING</span>':'<span style="color:var(--text3)">Below threshold</span>';
        line+='‚îú‚îÄ‚îÄ Automated Response ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';
        actions.forEach(function(act){line+='‚îÇ  ‚ö° '+act+'  '+actSev+'\n'});
      }
      line+='‚îî‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ‚îÄ\n';

      // Prepend new events at top
      var old=log.innerHTML;
      if(old==='Connecting to live event stream...')old='';
      log.innerHTML=line+'\n'+old;

      // Flash the card border briefly
      var card=document.getElementById('liveFeedCard');
      card.style.borderColor=sevColor;
      setTimeout(function(){card.style.borderColor='var(--accent)'},1500);

      // Also refresh the overview alert counters after a short delay
      setTimeout(refreshAll,2000);
    }catch(e){console.warn('SSE parse error',e)}
  });

  _sse.onerror=function(){
    dot.className='dot dot-red'; status.textContent='Disconnected ‚Äî reconnecting...';
    // EventSource auto-reconnects; update status when it does
  };
}

