    </main>
    <script>
        // Global state
        let currentTab = 'overview';
        let chatHistory = [];
        let creditsData = {};
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            loadCredits();
            loadStats();
            setInterval(loadCredits, 30000); // Refresh every 30s
            // Make sure tab content is correctly handled
            switchTab('overview');
        });
        
        // Tab switching
        function switchTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.add('hidden');
            });
            
            // Show selected tab
            const target = document.getElementById(`tab-${tabName}`);
            if (target) {
                target.classList.remove('hidden');
            }
            
            // Update nav styling
            document.querySelectorAll('.tab-btn').forEach(btn => {
                if (btn.dataset.tab === tabName) {
                    btn.classList.remove('border-transparent', 'text-gray-400');
                    btn.classList.add('border-cyan-500', 'text-cyan-400');
                } else {
                    btn.classList.add('border-transparent', 'text-gray-400');
                    btn.classList.remove('border-cyan-500', 'text-cyan-400');
                }
            });
            
            currentTab = tabName;
            
            // Load tab-specific data
            if (tabName === 'llm-credits') {
                renderProviderTable();
                initCharts();
            }
        }
        
        // Load credits from API
        async function loadCredits() {
            try {
                const response = await fetch('/api/llm/credits');
                const data = await response.json();
                creditsData = data;
                
                // Update header
                const healthyCount = data.healthy_count || 0;
                const totalProviders = Object.keys(data.providers || {}).length;
                const headerText = document.getElementById('header-credit-text');
                if (headerText) {
                    headerText.textContent = `${healthyCount}/${totalProviders} providers healthy`;
                }
                
                // Update mini list
                const miniList = document.getElementById('provider-mini-list');
                if (miniList) {
                    miniList.innerHTML = Object.entries(data.providers || {}).map(([name, info]) => `
                        <div class="flex items-center justify-between p-3 bg-gray-900 rounded-lg">
                            <div class="flex items-center gap-3">
                                <span class="w-2 h-2 rounded-full ${getStatusColor(info.status)}"></span>
                                <span class="text-sm font-medium capitalize">${name}</span>
                            </div>
                            <span class="text-xs text-gray-400">
                                ${info.remaining_credits ? '$' + info.remaining_credits.toFixed(2) : 'N/A'}
                            </span>
                        </div>
                    `).join('');
                }
                
                // Update credit tab if active
                if (currentTab === 'llm-credits') {
                    updateCreditDisplay(data);
                }
            } catch (error) {
                console.error('Failed to load credits:', error);
                const headerText = document.getElementById('header-credit-text');
                if(headerText) headerText.textContent = 'Error loading';
            }
        }
        
        function getStatusColor(status) {
            switch(status) {
                case 'healthy': return 'bg-green-500';
                case 'low_credit': return 'bg-yellow-500';
                case 'exhausted': return 'bg-red-500';
                default: return 'bg-gray-500';
            }
        }
        
        function updateCreditDisplay(data) {
            const totalRemaining = document.getElementById('total-remaining');
            if(totalRemaining) totalRemaining.textContent = '$' + (data.total_estimated_remaining || 0).toFixed(2);
            
            const activeProvider = document.getElementById('active-provider');
            if(activeProvider) activeProvider.textContent = data.recommended_provider || 'None';
            
            // Calculate health percentage
            const total = Object.keys(data.providers || {}).length;
            const healthy = data.healthy_count || 0;
            const percent = total > 0 ? Math.round((healthy / total) * 100) : 0;
            
            const creditPercent = document.getElementById('total-credit-percent');
            if(creditPercent) creditPercent.textContent = percent + '%';
            
            // Update gauge
            const gauge = document.getElementById('total-credit-gauge');
            if (gauge) {
                const healthyDeg = (percent / 100) * 360;
                const warningDeg = healthyDeg + 72; // 20% warning zone
                gauge.style.setProperty('--healthy-deg', healthyDeg + 'deg');
                gauge.style.setProperty('--warning-deg', Math.min(warningDeg, 360) + 'deg');
            }
        }
        
        function renderProviderTable() {
            const tbody = document.getElementById('provider-table-body');
            if (!tbody || !creditsData.providers) return;
            
            tbody.innerHTML = Object.entries(creditsData.providers).map(([name, info]) => `
                <tr class="hover:bg-gray-900 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-gray-800 flex items-center justify-center">
                                <i class="fas fa-microchip text-cyan-400"></i>
                            </div>
                            <span class="font-medium capitalize">${name}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-3 py-1 rounded-full text-xs font-medium ${getStatusBadgeClass(info.status)}">
                            ${info.status}
                        </span>
                    </td>
                    <td class="px-6 py-4 font-mono">
                        ${info.remaining_credits !== null ? 
                            '$' + info.remaining_credits.toFixed(2) + ' ' + info.currency : 
                            '<span class="text-gray-500">Unknown</span>'}
                    </td>
                    <td class="px-6 py-4 text-sm">
                        ${info.rate_limit_remaining !== null ? 
                            `${info.rate_limit_remaining}/${info.rate_limit_total}` : 
                            '<span class="text-gray-500">N/A</span>'}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-400">
                        ${info.last_checked ? new Date(info.last_checked).toLocaleTimeString() : 'Never'}
                    </td>
                    <td class="px-6 py-4">
                        <button onclick="checkProvider('${name}')" 
                            class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs transition-colors">
                            Check
                        </button>
                    </td>
                </tr>
            `).join('');
        }
        
        function getStatusBadgeClass(status) {
            switch(status) {
                case 'healthy': return 'bg-green-900 text-green-300';
                case 'low_credit': return 'bg-yellow-900 text-yellow-300';
                case 'exhausted': return 'bg-red-900 text-red-300';
                default: return 'bg-gray-800 text-gray-400';
            }
        }
        
        async function refreshCredits() {
            const btn = document.querySelector('button[onclick="refreshCredits()"]');
            if(btn) btn.classList.add('animate-spin');
            await loadCredits();
            renderProviderTable();
            if(btn) setTimeout(() => btn.classList.remove('animate-spin'), 500);
        }
        
        async function checkProvider(provider) {
            try {
                const response = await fetch(`/api/llm/credits/${provider}?force_refresh=true`);
                const data = await response.json();
                alert(`${provider.toUpperCase()} Status: ${data.status}\nRemaining: ${data.remaining_credits || 'Unknown'}`);
                loadCredits();
            } catch (error) {
                alert('Failed to check provider: ' + error.message);
            }
        }
        
        // Chat functionality
        async function sendMessage() {
            const input = document.getElementById('chat-input');
            const message = input.value.trim();
            if (!message) return;
            
            // Add user message
            addMessage(message, 'user');
            input.value = '';
            
            // Show typing indicator
            const typingId = showTyping();
            
            try {
                const response = await fetch('/api/analyst/chat', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        messages: [{role: 'user', content: message}],
                        use_tools: true
                    })
                });
                
                const data = await response.json();
                removeTyping(typingId);
                
                if (data.message && data.message.content) {
                    addMessage(data.message.content, 'assistant');
                } else if (data.analysis) {
                     // Fallback for direct analysis storage
                    addMessage(data.analysis.summary || "Analysis complete", 'assistant');
                }
                
                // Show tool results if any
                if (data.tool_results && data.tool_results.length > 0) {
                    data.tool_results.forEach(result => {
                        addToolResult(result);
                    });
                }
            } catch (error) {
                removeTyping(typingId);
                addMessage('Sorry, I encountered an error: ' + error.message, 'assistant');
            }
        }
        
        function addMessage(content, role) {
            const container = document.getElementById('chat-messages');
            const div = document.createElement('div');
            div.className = `chat-message ${role === 'user' ? 'chat-user' : 'chat-assistant'}`;
            div.innerHTML = `<p class="text-sm">${formatMessage(content)}</p>`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }
        
        function formatMessage(content) {
            if (!content) return '';
            // Simple markdown-like formatting
            return content
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/`(.*?)`/g, '<code class="bg-gray-800 px-1 rounded">$1</code>')
                .replace(/\n/g, '<br>');
        }
        
        function showTyping() {
            const container = document.getElementById('chat-messages');
            const id = 'typing-' + Date.now();
            const div = document.createElement('div');
            div.id = id;
            div.className = 'chat-message chat-assistant';
            div.innerHTML = '<p class="text-sm typing-indicator">Analyzing</p>';
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
            return id;
        }
        
        function removeTyping(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }
        
        function addToolResult(result) {
            const container = document.getElementById('chat-messages');
            const div = document.createElement('div');
            div.className = 'chat-message chat-assistant';
            div.style.opacity = '0.8';
            div.innerHTML = `
                <div class="flex items-center gap-2 mb-2">
                    <i class="fas fa-wrench text-cyan-400"></i>
                    <span class="text-xs font-mono text-cyan-400">Tool: ${result.tool}</span>
                </div>
                <pre class="text-xs bg-gray-900 p-2 rounded overflow-x-auto">${JSON.stringify(result.result || result.error, null, 2)}</pre>
            `;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }
        
        function quickAction(message) {
            const input = document.getElementById('chat-input');
            if (input) {
                input.value = message;
                sendMessage();
            }
        }
        
        function clearChat() {
            const container = document.getElementById('chat-messages');
            if (container) {
                container.innerHTML = `
                    <div class="chat-message chat-assistant">
                        <p class="text-sm">Chat cleared. How can I help you?</p>
                    </div>
                `;
            }
        }
        
        function loadExample() {
            const examples = [
                "Show me the last 5 critical alerts and analyze them",
                "Isolate the traffic-camera pod, it looks compromised",
                "Check my LLM credits and switch to the cheapest provider",
                "What's the current threat level of the system?"
            ];
            const random = examples[Math.floor(Math.random() * examples.length)];
            const input = document.getElementById('chat-input');
            if (input) input.value = random;
        }
        
        // Charts
        function initCharts() {
            // Cost chart
            const costCtx = document.getElementById('costChart');
            if (costCtx) {
                new Chart(costCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['OpenAI', 'Anthropic', 'xAI', 'Gemini', 'Moonshot'],
                        datasets: [{
                            data: [30, 25, 20, 15, 10],
                            backgroundColor: ['#00f0ff', '#b829dd', '#ff3366', '#00ff88', '#ffaa00']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom', labels: { color: '#a0a0b0' } }
                        }
                    }
                });
            }
            
            // Usage chart
            const usageCtx = document.getElementById('usageChart');
            if (usageCtx) {
                new Chart(usageCtx, {
                    type: 'line',
                    data: {
                        labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00'],
                        datasets: [{
                            label: 'API Calls',
                            data: [12, 19, 35, 52, 45, 30],
                            borderColor: '#00f0ff',
                            backgroundColor: 'rgba(0, 240, 255, 0.1)',
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { labels: { color: '#a0a0b0' } }
                        },
                        scales: {
                            x: { ticks: { color: '#a0a0b0' }, grid: { color: '#2a2a3a' } },
                            y: { ticks: { color: '#a0a0b0' }, grid: { color: '#2a2a3a' } }
                        }
                    }
                });
            }
        }
        
        function loadStats() {
            // Mock stats - replace with actual API calls
            const threatsEl = document.getElementById('stat-threats');
            if(threatsEl) threatsEl.textContent = '3';
            
            const alertsEl = document.getElementById('stat-alerts');
            if (alertsEl) alertsEl.textContent = '24';
            
            const costEl = document.getElementById('stat-cost');
            if (costEl) costEl.textContent = '$2.45';
            
            // Alerts chart
            const ctx = document.getElementById('alertsChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00', 'Now'],
                        datasets: [{
                            label: 'Critical',
                            data: [0, 1, 0, 2, 1, 0, 1],
                            borderColor: '#ff3366',
                            backgroundColor: 'rgba(255, 51, 102, 0.1)',
                            fill: true
                        }, {
                            label: 'High',
                            data: [2, 3, 5, 4, 6, 3, 2],
                            borderColor: '#ffaa00',
                            backgroundColor: 'rgba(255, 170, 0, 0.1)',
                            fill: true
                        }, {
                            label: 'Medium',
                            data: [5, 8, 12, 10, 15, 8, 6],
                            borderColor: '#00f0ff',
                            backgroundColor: 'rgba(0, 240, 255, 0.1)',
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: { labels: { color: '#a0a0b0' } }
                        },
                        scales: {
                            x: { ticks: { color: '#a0a0b0' }, grid: { color: '#2a2a3a' } },
                            y: { ticks: { color: '#a0a0b0' }, grid: { color: '#2a2a3a' } }
                        }
                    }
                });
            }
        }
    </script>
