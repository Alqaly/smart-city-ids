    logger.info(f"[ACTION] Scaling service: {service_name} in {namespace} to {replicas} replicas")
    apps_v1 = kubernetes.client.AppsV1Api()
    try:
        dep = apps_v1.read_namespaced_deployment(service_name, namespace)
