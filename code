_sse_clients: list = []  # list of asyncio.Queue

async def _sse_broadcast(event: dict):
    """Push an event to all connected SSE clients."""
    dead = []
    for q in _sse_clients:
        try:
            q.put_nowait(event)
        except asyncio.QueueFull:
            dead.append(q)
    for q in dead:
        _sse_clients.remove(q)


