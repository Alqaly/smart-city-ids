function renderOverview(m,h,cb,safety,prod,gov,llmFromHealth,llmDiag){
  if(!m)return;
  var uptime=m.uptime_seconds?formatDuration(m.uptime_seconds):'--';
  var smry=(llmDiag&&llmDiag.summary)?llmDiag.summary:{};
  var llmSub='';
  if(smry.operational||smry.error||smry.cooldown){
    var parts=[];
    if(smry.operational)parts.push(smry.operational+' healthy');
    if(smry.error)parts.push(smry.error+' error');
    if(smry.cooldown)parts.push(smry.cooldown+' cooldown');
