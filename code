async def _process_analyst_query(
    message: str, 
    tools: List[Dict],
    governance_mode: str
) -> Dict[str, Any]:
    """
    Process analyst query using rule-based matching.
    
    In production, this would call an LLM with tool support.
    """
    message_lower = message.lower()
    tool_calls = []
    tool_results = []
    context = {}
    
    # Check for credit-related queries
    if any(kw in message_lower for kw in ["credit", "balance", "cost", "money", "spent"]):
        result = await execute_tool_call("get_credit_status", {}, governance_mode)
        context["credits"] = result
        
        # Build natural response
        if result.get("status") == "success":
            providers = result.get("providers", {})
            summary = []
            for name, info in providers.items():
                if info.get("credits") is not None:
                    summary.append(f"{name}: ${info['credits']:.2f} ({info['status']})")
                else:
                    summary.append(f"{name}: {info.get('status', 'unknown')}")
            
            response = "Current LLM credit status:\n" + "\n".join(f"‚Ä¢ {s}" for s in summary)
        else:
            response = f"Unable to check credits: {result.get('message', 'Unknown error')}"
        
        return {
            "response": response,
            "tool_calls": [{"name": "get_credit_status", "arguments": {}}],
            "tool_results": [result],
            "context": context
        }
    
    # Check for pod status queries
    if any(kw in message_lower for kw in ["pod", "container", "running", "status"]):
        namespace = "smart-city"
        # Try to extract namespace
        if "falco" in message_lower:
            namespace = "falco-system"
        elif "monitoring" in message_lower:
            namespace = "monitoring"
        
        result = await execute_tool_call("get_pod_status", {"namespace": namespace}, governance_mode)
        context["pods"] = result
        
        if result.get("status") == "success":
            pods = result.get("pods", [])
            running = sum(1 for p in pods if p.get("status") == "Running")
            response = f"Pod status in {namespace}:\n"
            response += f"‚Ä¢ Total: {len(pods)} pods\n"
            response += f"‚Ä¢ Running: {running}\n"
            response += f"‚Ä¢ Other: {len(pods) - running}\n\n"
            response += "Recent pods:\n"
            for pod in pods[:5]:
                response += f"‚Ä¢ {pod['name']}: {pod['status']}\n"
        else:
            response = f"Unable to get pod status: {result.get('message', 'Unknown error')}"
        
        return {
            "response": response,
            "tool_calls": [{"name": "get_pod_status", "arguments": {"namespace": namespace}}],
            "tool_results": [result],
            "context": context
        }
    
    # Check for alert queries
    if any(kw in message_lower for kw in ["alert", "incident", "threat", "attack"]):
        result = await execute_tool_call("get_active_alerts", {"limit": 10}, governance_mode)
        context["alerts"] = result
        
        if result.get("status") == "success":
            alerts = result.get("alerts", [])
